# Optional. No credentials needed for the default offline loopback demo.
APP_ENV=development
RUNTIME_DIR=runtime
LOCAL_TEMP_DIR=runtime/tmp
GRAPH_MODE=langgraph
MAX_WORKERS=2
ALLOW_FAULT_INJECTION=true
# Enable accounts before shared deployment.
AUTH_ENABLED=false
REGISTRATION_ENABLED=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
HR_USERNAME=hr
HR_PASSWORD_HASH=
API_TOKEN=
# Empty URLs select SQLite and lexical retrieval.
DATABASE_URL=
REDIS_URL=
MILVUS_URI=
MILVUS_TOKEN=
MILVUS_COLLECTION=process_knowledge_v2
SHORT_MEMORY_TTL=86400
# Opt-in model calls. Choose current IDs supported by your provider.
USE_LLM=false
MODEL_PROVIDER=openai
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
MODEL_TIMEOUT=40
MODEL_MAX_TOKENS=1200
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_API_KEY=
AGENT_MODEL=
HIGH_RISK_EXTRACT_MODEL=
RULE_REASONING_MODEL=
# Vector settings apply only when Milvus is configured.
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DIMENSION=512
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_BATCH_SIZE=8
RETRIEVAL_CANDIDATES=12
RETRIEVAL_LIMIT=4
RERANKER_ENABLED=false
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# Remote document/audio services are opt-in.
DOCUMENT_ENABLED=false
PADDLE_OFFICIAL_BASE_URL=https://paddleocr.aistudio-app.com
PADDLE_OFFICIAL_API_KEY=
SPEECH_ENABLED=false
SPEECH_MODEL=FunAudioLLM/SenseVoiceSmall
DOCUMENT_MAX_BYTES=4000000
DOCUMENT_DAILY_LIMIT=10
DOCUMENT_POLL_TIMEOUT=90
# Generated privately by scripts.init_env for infrastructure modes.
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
REDIS_PASSWORD=
MINIO_ROOT_USER=industrial
MINIO_ROOT_PASSWORD=
APP_IMAGE=proclab:3.0.0
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
SITE_ADDRESS=
SESSION_TTL_SECONDS=43200
DEMO_DAILY_TASKS=30
DEMO_GLOBAL_DAILY_TASKS=100
HARNESS_MAX_TOOL_CALLS=12
HARNESS_TIMEOUT_SECONDS=180
HARNESS_MAX_REPAIRS=2
