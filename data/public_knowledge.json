    "limits": {}
  },
  {
    "doc_id": "PUBLIC-NIST-MONITOR",
    "title": "监控与事后检查",
    "content": "过程监控帮助理解生产过程中的变化，而最终产品检查关注结果。工艺测量记录的比较不能替代全面的产品检验。",
    "source": "https://www.itl.nist.gov/div898/handbook/pmc/section1/pmc12.htm",
